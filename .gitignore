# Only ship gzipped data to keep the repo under GitHub Pages's 1 GB cap.
data/*.json
!data/integrity.json
!data/.gitkeep
# v121 — metadata-only restricted-source register (no copyrighted text)
!data/restricted_sources_register.json
# 2026-07-27 — dataflow lane 1: the build manifest is the deploy contract
# (hashes + counts + restriction reasons; no text). Tracked by negation,
# NOT force-add — generated files must be visibly tracked or not at all.
!data/build_manifest.json
# Its gzip twin is a local build artifact (gzip_web_data rglobs *.json) —
# nothing fetches it; keep it unsweepable.
data/build_manifest.json.gz

# Dev-only pages — not for public visitors
# (kept individually for the existing tracked names; _legacy/ and
# _admin/ patterns below cover future moves into private directories)
old.html
inventory.html
inventory_source.html
issues.html
metadata_audit.html
source_status.html

# Convention: underscore-prefixed top-level dirs are private
# (see workspace-hub/CONVENTIONS.md). _legacy holds retired surfaces;
# _admin holds dev/admin pages not intended for the public Reading Room.
# _build holds the uncompressed working copies of generated bodies
# (dataflow lane 4, 2026-07-27) — data/ ships only the .json.gz.
_legacy/
_admin/
_build/

# Restricted/copyrighted texts — local only, never push
data/dead-sea-scrolls-*.json
data/dead-sea-scrolls-*.json.gz
data/hesse-siddhartha*.json
data/hesse-siddhartha*.json.gz
data/gospel-ramakrishna*.json
data/gospel-ramakrishna*.json.gz
data/think-grow-rich*.json
data/think-grow-rich*.json.gz

# v109 — Restricted-source directory pattern. Any text whose copyright
# status is unclear or known-restricted is ingested into _restricted/
# and never committed. See reports/v109_restricted_source_protocol.md.
data/_restricted/

# v124 — Local-only restricted loader. NEVER commit local restricted
# text, the activated local config, or the real local index. Only the
# committed metadata-only register (above) and the committed *template*
# files (in data/restricted_templates/, which contain no copyrighted
# text) ship publicly. See reports/v124_local_restricted_loader_architecture.md.
**/_restricted/
*.restricted.json
restricted_index.local.json
restricted_sources.local.json
local_restricted_config.json
restricted_local_config.json
# (Templates are explicitly allowed — they contain metadata only and
#  live in data/restricted_templates/, which `data/*.json` does not
#  match. The patterns above target the *real* local files by exact
#  name, never the *.template.json variants.)

# Compressed copies of the public register/templates are redundant local
# build artifacts — the app loads the .json (and data/index.json.gz), not
# these. Ignore so a broad add can't stage them; tracked *.json /
# *.template.json are unaffected (different extension).
data/restricted_sources_register.json.gz
data/restricted_templates/*.json.gz

# Local runtime
.server.pid
.claude/
.DS_Store
Thumbs.db

# Python tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Maintenance reports — only the human-readable Markdown summaries are
# published; the full JSON outputs are local-only since they reproduce
# from the canonical library on demand.
reports/*.json
reports/_flagged_text_ids.json
reports/ingestion_issues.json
reports/repair_analysis.json
reports/unmatched_block_review.json
reports/whitelist_*.json

