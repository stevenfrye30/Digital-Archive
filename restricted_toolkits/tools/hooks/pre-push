#!/usr/bin/env bash
# restricted_toolkits guard — block a PUSH if the restricted/public boundary is broken.
# Active when core.hooksPath = restricted_toolkits/tools/hooks (see install-hooks.sh).
# Runs the canonical leak-check (05_scripts/check_restricted_invariants.py in the
# local-only root repo, the parent of this deploy repo). Fails CLOSED: if the check
# cannot run or does not pass, the push is aborted.
set -euo pipefail

TOP="$(git rev-parse --show-toplevel)"          # .../03_web_app  (this deploy repo)
CHECK="$TOP/../05_scripts/check_restricted_invariants.py"

if [ ! -f "$CHECK" ]; then
  echo "pre-push BLOCKED: leak-check not found at:"
  echo "  $CHECK"
  echo "The restricted/public boundary check must run before pushing the public deploy."
  echo "(It lives in the local-only root repo. Push only from the full workspace layout.)"
  exit 1
fi

echo "pre-push: running restricted/public boundary check ..."
if ! python "$CHECK"; then
  echo ""
  echo "pre-push BLOCKED: restricted/public invariants FAILED — not pushing."
  echo "A restricted text would ship publicly. Fix the leak, then push again."
  exit 1
fi
echo "pre-push: boundary check passed — push allowed."
exit 0
