#!/usr/bin/env bash
# restricted_toolkits guard — block a PUSH unless the deploy contract verifies.
# Active when core.hooksPath = restricted_toolkits/tools/hooks (see install-hooks.sh).
# Runs guard v2 (tools/prepush_guard.py, in THIS repo). It supersedes the old
# parent-side check_restricted_invariants.py: every invariant is derived from
# data/build_manifest.json — counts ≡ index.json ≡ STATUS.md, a reason on every
# restricted entry, no tracked restricted body, and a full sha256 verify of every
# shipping artifact. Fails CLOSED: if the guard cannot run or does not pass, the
# push is aborted.
set -euo pipefail

TOP="$(git rev-parse --show-toplevel)"          # .../03_web_app  (this deploy repo)
GUARD="$TOP/tools/prepush_guard.py"

if [ ! -f "$GUARD" ]; then
  echo "pre-push BLOCKED: guard not found at:"
  echo "  $GUARD"
  echo "The deploy-contract guard must run before pushing the public deploy."
  exit 1
fi

echo "pre-push: running deploy-contract guard (v2) ..."
if ! python "$GUARD"; then
  echo ""
  echo "pre-push BLOCKED: deploy-contract invariants FAILED — not pushing."
  echo "A restricted text would ship publicly, or the manifest disagrees with the"
  echo "tree. Fix the failure, then push again."
  exit 1
fi
echo "pre-push: guard passed — push allowed."
exit 0
